{
  "manifest_version": 3,
  "name": "Wanderlog Notes Clipper",
  "version": "0.4.0",
  "description": "Clip travel notes and prepare Wanderlog destination imports from selected text or pasted lists.",
  "homepage_url": "https://github.com/rosemontni/extension",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "contextMenus",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://app.wanderlog.com/*",
    "https://extensionembed.wanderlog.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Wanderlog"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.wanderlog.com/*"],
      "js": ["wanderlog-app.js"],
      "run_at": "document_idle"
    }
  ]
}
