{
  "manifest_version": 3,
  "name": "Wanderlog Save Demo",
  "version": "0.1.0",
  "description": "Search and save places or start a Wanderlog trip destination from highlighted text.",
  "permissions": ["activeTab", "contextMenus", "scripting", "storage", "tabs"],
  "host_permissions": [
    "<all_urls>",
    "https://app.wanderlog.com/*",
    "https://extensionembed.wanderlog.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Wanderlog"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
